# LARAVEL OPTIONS (only keys present in Application env templates are written)
APP_ENV=local
APP_DEBUG=true
APP_URL=http://ivory.test

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ivory
DB_USERNAME=root
DB_PASSWORD=

