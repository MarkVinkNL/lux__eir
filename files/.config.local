EIR_SYS_ENV=local
EIR_SYS_GIT=git
EIR_SYS_PHP=php
EIR_SYS_COMPOSER=composer

EIR_SITE_FOLDER=app
EIR_IMAGES_FOLDER=images
EIR_FILES_FOLDER=files

EIR_GIT_REMOTE_BRANCH=development
